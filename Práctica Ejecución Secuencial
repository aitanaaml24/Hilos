void atomicHilo1()
{
    auto inicio = high_resolution_clock::now();

    long long contadorLocal = 0;

    for (int i = 0; i < NUM_DATOS; i++)
    {
        int resultado = datos[i] * 2;

        contadorLocal++;

        contadorGlobalAtomic.fetch_add(1);
    }

    contadorAtomicHilo1.store(contadorLocal);

    auto fin = high_resolution_clock::now();

    duration<double> tiempo = fin - inicio;

    cout << "Atomic - Hilo 1: "
         << contadorAtomicHilo1.load() << endl;

    cout << "Tiempo Atomic Hilo 1: "
         << tiempo.count()
         << " segundos" << endl;
}


