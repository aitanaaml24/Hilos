#include <iostream>
#include <thread>
#include <atomic>
#include <mutex>
#include <chrono>
#include <vector>
#include <random>
#include <iomanip>

using namespace std;
using namespace std::chrono;

// =====================================================
// CONFIGURACIÓN GENERAL
// =====================================================
const int NUM_DATOS = 10000000;
const int X = 50;

vector<int> datos(NUM_DATOS);

// Variables para almacenar los tiempos del reporte final
double tiempoMutex = 0.0;
double tiempoAtomic = 0.0;
double tiempoSecuencial = 0.0;


// =====================================================
// MODALIDAD A: USO DE MUTEX
// =====================================================

long long contM_Hilo1 = 0, contM_Hilo2 = 0, contM_Hilo3 = 0;
long long contM_Global = 0;
mutex mtxGlobal;

void hilo1_mutex() {
    long long local = 0;
    for (int i = 0; i < NUM_DATOS; i++) {
        int resultado = datos[i] * 2;
        local++;
        lock_guard<mutex> lock(mtxGlobal);
        contM_Global++;
    }
    contM_Hilo1 = local;
}

void hilo2_mutex() {
    long long local = 0;
    for (int i = 0; i < NUM_DATOS; i++) {
        if (X != 0 && datos[i] % X == 0) {
            local++;
        }
        lock_guard<mutex> lock(mtxGlobal);
        contM_Global++;
    }
    contM_Hilo2 = local;
}

void hilo3_mutex() {
    long long local = 0;
    for (int i = 0; i < NUM_DATOS; i++) {
        if (datos[i] > X) {
            local++;
        }
        lock_guard<mutex> lock(mtxGlobal);
        contM_Global++;
    }
    contM_Hilo3 = local;
}

void ejecutar_modalidad_mutex() {
    cout << "\n------------------------------------------" << endl;
    cout << " MODALIDAD A: 3 HILOS CON MUTEX" << endl;
    cout << "------------------------------------------" << endl;

    contM_Hilo1 = contM_Hilo2 = contM_Hilo3 = contM_Global = 0;

    auto inicio = high_resolution_clock::now();

    thread t1(hilo1_mutex);
    thread t2(hilo2_mutex);
    thread t3(hilo3_mutex);

    t1.join();
    t2.join();
    t3.join();

    auto fin = high_resolution_clock::now();
    duration<double> duracion = fin - inicio;
    tiempoMutex = duracion.count();

    cout << "Contador Hilo 1: " << contM_Hilo1 << endl;
    cout << "Contador Hilo 2: " << contM_Hilo2 << endl;
    cout << "Contador Hilo 3: " << contM_Hilo3 << endl;
    cout << "Contador Global: " << contM_Global << endl;
    cout << "Tiempo de ejecucion (Mutex): " << tiempoMutex << " segundos." << endl;
}


// =====================================================
// MODALIDAD B: USO DE ATOMIC
// =====================================================

atomic<long long> contA_Hilo1(0);
atomic<long long> contA_Hilo2(0);
atomic<long long> contA_Hilo3(0);
atomic<long long> contA_Global(0);

void hilo1_atomic() {
    long long local = 0;
    for (int i = 0; i < NUM_DATOS; i++) {
        int resultado = datos[i] * 2;
        local++;
        contA_Global.fetch_add(1);
    }
    contA_Hilo1.store(local);
}

void hilo2_atomic() {
    long long local = 0;
    for (int i = 0; i < NUM_DATOS; i++) {
        if (X != 0 && datos[i] % X == 0) {
            local++;
        }
        contA_Global.fetch_add(1);
    }
    contA_Hilo2.store(local);
}

void hilo3_atomic() {
    long long local = 0;
    for (int i = 0; i < NUM_DATOS; i++) {
        if (datos[i] > X) {
            local++;
        }
        contA_Global.fetch_add(1);
    }
    contA_Hilo3.store(local);
}

void ejecutar_modalidad_atomic() {
    cout << "\n------------------------------------------" << endl;
    cout << " MODALIDAD B: 3 HILOS CON ATOMIC" << endl;
    cout << "------------------------------------------" << endl;

    contA_Hilo1 = contA_Hilo2 = contA_Hilo3 = contA_Global = 0;

    auto inicio = high_resolution_clock::now();

    thread t1(hilo1_atomic);
    thread t2(hilo2_atomic);
    thread t3(hilo3_atomic);

    t1.join();
    t2.join();
    t3.join();

    auto fin = high_resolution_clock::now();
    duration<double> duracion = fin - inicio;
    tiempoAtomic = duracion.count();

    cout << "Contador Hilo 1: " << contA_Hilo1.load() << endl;
    cout << "Contador Hilo 2: " << contA_Hilo2.load() << endl;
    cout << "Contador Hilo 3: " << contA_Hilo3.load() << endl;
    cout << "Contador Global: " << contA_Global.load() << endl;
    cout << "Tiempo de ejecucion (Atomic): " << tiempoAtomic << " segundos." << endl;
}


// =====================================================
// MODALIDAD C: SECUENCIAL (SIN HILOS)
// =====================================================

void ejecutar_modalidad_secuencial() {
    cout << "\n------------------------------------------" << endl;
    cout << " MODALIDAD C: EJECUCION SECUENCIAL" << endl;
    cout << "------------------------------------------" << endl;

    long long contS_Hilo1 = 0, contS_Hilo2 = 0, contS_Hilo3 = 0;
    long long contS_Global = 0;

    auto inicio = high_resolution_clock::now();

    // Proceso 1
    for (int i = 0; i < NUM_DATOS; i++) {
        int resultado = datos[i] * 2;
        contS_Hilo1++;
        contS_Global++;
    }

    // Proceso 2
    for (int i = 0; i < NUM_DATOS; i++) {
        if (X != 0 && datos[i] % X == 0) {
            contS_Hilo2++;
        }
        contS_Global++;
    }

    // Proceso 3
    for (int i = 0; i < NUM_DATOS; i++) {
        if (datos[i] > X) {
            contS_Hilo3++;
        }
        contS_Global++;
    }

    auto fin = high_resolution_clock::now();
    duration<double> duracion = fin - inicio;
    tiempoSecuencial = duracion.count();

    cout << "Contador Proceso 1: " << contS_Hilo1 << endl;
    cout << "Contador Proceso 2: " << contS_Hilo2 << endl;
    cout << "Contador Proceso 3: " << contS_Hilo3 << endl;
    cout << "Contador Global: " << contS_Global << endl;
    cout << "Tiempo de ejecucion (Secuencial): " << tiempoSecuencial << " segundos." << endl;
}


// =====================================================
// REPORTE COMPARATIVO FINAL
// =====================================================

void mostrar_reporte_tiempos() {
    cout << "\n==================================================" << endl;
    cout << " REPORTE COMPARATIVO DE TIEMPOS DE EJECUCION " << endl;
    cout << "==================================================" << endl;
    cout << fixed << setprecision(6);
    cout << " A) Tres Hilos con MUTEX: " << tiempoMutex << " segundos" << endl;
    cout << " B) Tres Hilos con ATOMIC: " << tiempoAtomic << " segundos" << endl;
    cout << " C) Ejecucion SECUENCIAL: " << tiempoSecuencial << " segundos" << endl;
    cout << "==================================================" << endl;
}


// =====================================================
// FUNCIÓN PRINCIPAL
// =====================================================

int main() {
    cout << "==========================================" << endl;
    cout << " BENCHMARK" << endl;
    cout << "==========================================" << endl;
    cout << "Generando " << NUM_DATOS << " datos aleatorios..." << endl;

    mt19937 generador(12345);
    uniform_int_distribution<int> distribucion(1, 100);

    for (int i = 0; i < NUM_DATOS; i++) {
        datos[i] = distribucion(generador);
    }
    cout << "Datos generados correctamente.\n" << endl;

    // Ejecutar las tres modalidades exigidas
    ejecutar_modalidad_mutex();
    ejecutar_modalidad_atomic();
    ejecutar_modalidad_secuencial();

    // Generar reporte final (Incisos d)
    mostrar_reporte_tiempos();

    return 0;
}
