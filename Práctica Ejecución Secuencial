        // Operación aritmética
        int resultado = datos[i] * 2;

        contadorLocal++;

        // Variable global protegida por Mutex
        mtx.lock();

        contadorGlobalMutex++;

        mtx.unlock();
    }

    contadorMutexHilo1 = contadorLocal;

    auto fin = high_resolution_clock::now();

    duration<double> tiempo = fin - inicio;

    cout << "Mutex - Hilo 1: "
         << contadorMutexHilo1 << endl;

    cout << "Tiempo Mutex Hilo 1: "
         << tiempo.count()
         << " segundos" << endl;
}


