// ============================================================================
// FUNCIÓN PRINCIPAL
// ============================================================================
int main() {
    // Parámetros de trabajo
    const long long TOTAL_DATOS = 10000000; // 10 Millones de datos
    const int FACTOR_MULTIPLO = 7;          // Parámetro para Hilo 2

    std::cout << "====================================================\n";
    std::cout << "  INICIANDO EJECUCIÓN MULTIHILO (10 MILLONES DE DATOS)\n";
    std::cout << "====================================================\n\n";

    // Crear y lanzar los tres hilos en paralelo
    std::thread t1(ejecutarHilo1, TOTAL_DATOS);
    std::thread t2(ejecutarHilo2, TOTAL_DATOS, FACTOR_MULTIPLO);
    std::thread t3(ejecutarHilo3, TOTAL_DATOS);

    // Esperar a que los tres hilos concluyan sus procesos
    t1.join();
    t2.join();
    t3.join();

    // Suma global requerida: ContadorGlobal = ContadorHilo1 + ContadorHilo2 + ContadorHilo3
    long long sumaTotal = contadorHilo1.load() + contadorHilo2.load() + contadorHilo3.load();
    contadorGlobal.store(sumaTotal);

    // Despliegue del resumen de resultados
    std::cout << "====================================================\n";
    std::cout << "                RESUMEN DE RESULTADOS               \n";
    std::cout << "====================================================\n";
    std::cout << "Contador Hilo 1 (Operaciones) : " << contadorHilo1.load() << "\n";
    std::cout << "Contador Hilo 2 (Múltiplos)   : " << contadorHilo2.load() << "\n";
    std::cout << "Contador Hilo 3 (Mayores a X) : " << contadorHilo3.load() << "\n";
    std::cout << "----------------------------------------------------\n";
    std::cout << "CONTADOR GLOBAL (SUMA TOTAL)  : " << contadorGlobal.load() << "\n";
    std::cout << "====================================================\n";

    return 0;
}
