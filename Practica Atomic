#include <iostream>
#include <thread>
#include <atomic>
#include <chrono>
#include <vector>
#include <random>

using namespace std;
using namespace std::chrono;

// =====================================================
// CONFIGURACIÓN GENERAL
// =====================================================

const int NUM_DATOS = 10000000;
const int X = 50;

// =====================================================
// VARIABLES ATOMIC
// =====================================================

// Contadores individuales de cada hilo
atomic<long long> contadorHilo1(0);
atomic<long long> contadorHilo2(0);
atomic<long long> contadorHilo3(0);

// Variable global compartida por los 3 hilos
atomic<long long> contadorGlobal(0);

vector<int> datos(NUM_DATOS);


// =====================================================
// HILO 1 - AITANA
// =====================================================
// PROCESO:
// Realizar operaciones aritméticas con los 10 millones
// de datos.
//
// En este caso se realiza una multiplicación.
// =====================================================

void hilo1()
{
    auto inicio = high_resolution_clock::now();

    long long contadorLocal = 0;

    for (int i = 0; i < NUM_DATOS; i++)
    {

        int resultado = datos[i] * 2;
        contadorLocal++;
        contadorGlobal.fetch_add(1);
    }

    contadorHilo1.store(contadorLocal);

    auto fin = high_resolution_clock::now();

    duration<double> tiempo = fin - inicio;

    cout << "Hilo 1 - Operaciones realizadas: "
         << contadorHilo1.load() << endl;

    cout << "Tiempo Hilo 1: "
         << tiempo.count()
         << " segundos" << endl;
}


// =====================================================
// HILO 2 - Dessireé Niño Santel
// =====================================================
// PROCESO:
// Buscar la cantidad de números múltiplos de X.
//
// =====================================================

void hilo2()
{
    auto inicio = high_resolution_clock::now();

    long long contadorLocal = 0;

    for (int i = 0; i < NUM_DATOS; i++)
    {
        if (X != 0 && datos[i] % X == 0)
        {
            contadorLocal++;
        }

        contadorGlobal.fetch_add(1);
    }

    contadorHilo2.store(contadorLocal);

    auto fin = high_resolution_clock::now();
    duration<double> tiempo = fin - inicio;

    cout << "Hilo 2 - Cantidad de multiplos de " << X << " encontrados: "
         << contadorHilo2.load() << endl;

    cout << "Tiempo Hilo 2: "
         << tiempo.count()
         << " segundos" << endl;
}

// =====================================================
// Hilo 3: Carlos Romero Samano
// =====================================================
// PROCESO:
// Cantidad de Números mayores encontrados 
// =====================================================

void hilo3() 
{
    auto inicio = high_resolution_clock::now();

    long long contadorLocal = 0;

    for (int i = 0; i < NUM_DATOS; ++i) 
    {
        if (datos[i] > X) 
        {
            contadorLocal++;
        }
        contadorGlobal.fetch_add(1);
    }

    contadorHilo3.store(contadorLocal);

    auto fin = high_resolution_clock::now();
    duration<double> tiempo = fin - inicio;

    cout << "Hilo 3 - Numeros mayores a " << X << ": " 
         << contadorHilo3.load() << endl;

    cout << "Tiempo Hilo 3: "
         << tiempo.count()
         << " segundos" << endl;
}


