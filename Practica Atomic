// HILO 1 - PERSONA 1
// =====================================================
// PROCESO:
// Realizar operaciones aritméticas con los 10 millones
// de datos.
//
// En este caso se realiza una multiplicación.
// =====================================================

void hilo1()
{
    // Inicio del tiempo del Hilo 1
    auto inicio = high_resolution_clock::now();

    long long contadorLocal = 0;

    // Recorrer los 10 millones de datos
    for (int i = 0; i < NUM_DATOS; i++)
    {
        // Operación aritmética
        int resultado = datos[i] * 2;

        // Contar la operación realizada
        contadorLocal++;

        // Modificar la variable global
        contadorGlobal.fetch_add(1);
    }

    // Guardar el resultado del hilo
    contadorHilo1.store(contadorLocal);

    // Fin del tiempo del Hilo 1
    auto fin = high_resolution_clock::now();

    duration<double> tiempo = fin - inicio;

    cout << "Hilo 1 - Operaciones realizadas: "
         << contadorHilo1.load() << endl;

    cout << "Tiempo Hilo 1: "
         << tiempo.count()
         << " segundos" << endl;
}


