// ============================================================================
// HILO 2: (TU HILO)
// Tarea: Cantidad de números múltiplos de X encontrados en 10 millones de datos
// ============================================================================
void ejecutarHilo2(long long totalDatos, int factorMultiplo) {
    std::cout << "[Hilo 2] Iniciando procesamiento de " << totalDatos << " datos...\n";
    
    long long contadorMúltiplosLocal = 0;

    // Proceso pesado: Evaluar 10 millones de iteraciones
    for (long long i = 1; i <= totalDatos; ++i) {
        if (i % factorMultiplo == 0) {
            contadorMúltiplosLocal++;
        }
    }

    // Asignación final al contador del Hilo 2
    contadorHilo2.store(contadorMúltiplosLocal);

    // Muestra el valor del contador al final de su proceso
    std::cout << "[Hilo 2] Proceso finalizado.\n";
    std::cout << "[Hilo 2] Cantidad de multiplos de " << factorMultiplo 
              << " encontrados: " << contadorHilo2.load() << "\n\n";
}


